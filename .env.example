# Copiá este archivo como .env y ajustá los valores.
# No subas .env al repositorio: contiene configuración sensible.

# URL pública que se usa para armar los enlaces de presupuestos.
# En local: http://localhost:8080
# En producción: https://tu-dominio.com
APP_BASE_URL=http://localhost:8080

# Contraseña de la base de datos.
# Para H2 local puede quedar vacía.
# Si usás PostgreSQL, definí una contraseña larga y aleatoria.
DB_PASSWORD=

# Poné true SOLO cuando la app se sirva por HTTPS.
SESSION_COOKIE_SECURE=false

# Permite que cualquier persona cree una cuenta.
# En una demo cerrada podés poner false y crear usuarios manualmente.
REGISTRATION_ENABLED=true

# Días de validez de los enlaces públicos de presupuestos.
PUBLIC_QUOTE_DAYS=30

# Límite de intentos fallidos de login por IP y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
